---
// Full-screen CV document, generated from the same profile data as the terminal.
// Rendered server-side (indexable); shown/hidden by app.ts. View-only: no download or print actions.
import { profile as P } from '../data/profile';
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<div id="cv" class="viewer" role="dialog" aria-modal="true" aria-labelledby="cv-title" hidden>
  <div class="v-bar" role="toolbar" aria-label="CV document">
    <button type="button" class="tool primary" data-close>← <span class="lbl">Terminal</span> <kbd class="hide-touch">Esc</kbd></button>
    <span class="v-title" id="cv-title">CV — {P.name}</span>
    <span class="v-zoom hide-touch">
      <button type="button" class="tool" data-zoom="-0.1" aria-label="Zoom out">−</button>
      <span data-zoom-label aria-live="polite">100%</span>
      <button type="button" class="tool" data-zoom="0.1" aria-label="Zoom in">+</button>
    </span>
  </div>
  <div class="v-scroll">
    <article class="paper">
      <header class="cv-head">
        <h1>{P.name} <span class="cv-alias">({P.alias})</span></h1>
        <p class="cv-role">{P.title}</p>
        <p class="cv-meta">
          <span>{P.location}</span>
          {P.contact.email && <a href={`mailto:${P.contact.email}`}>{P.contact.email}</a>}
          {P.contact.phone && <span>{P.contact.phone}</span>}
          {P.links.map((l) => <a href={l.url}>{l.display ?? strip(l.url)}</a>)}
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{P.summary} {P.stack}</p>
        <p>{P.story.slice(0, 3).join(' ')}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {P.experience.map((e) => (
          <div class="cv-item">
            <div class="cv-item-head">
              <h3>{e.role} · {e.company}</h3>
              <span>{e.period ?? ''}</span>
            </div>
            <p class="cv-sub">{e.domain}{e.location && ` · ${e.location}`}</p>
            {e.products && <p>{e.products.map((x, i) => <>{i > 0 && '; '}<b>{x.name}</b> — {x.description}</>)}</p>}
            <ul>{e.work.map((w) => <li>{w}</li>)}</ul>
          </div>
        ))}
      </section>

      <section>
        <h2>Expertise</h2>
        <dl class="cv-dl">
          {P.expertise.map((x) => <><dt>{x.title}</dt><dd>{x.areas.join(', ')}</dd></>)}
        </dl>
      </section>

      <section>
        <h2>Education</h2>
        {P.education.map((e) => (
          <div class="cv-item cv-edu">
            <div class="cv-item-head">
              <h3>{e.degree}</h3>
              <span>{e.period && `${e.period} · `}{e.score}</span>
            </div>
            {e.institution && <p class="cv-sub">{e.institution}</p>}
          </div>
        ))}
      </section>

      <section>
        <h2>Robotics &amp; Achievements</h2>
        <p>{P.robotics.intro}</p>
        <ul>
          {P.robotics.awards.map((a) => <li><b>{a.place}</b> — {a.event} {a.year}, {a.host}{a.note && <span class="cv-sub"> · {a.note}</span>}</li>)}
        </ul>
        <p>{P.robotics.agv} <span class="cv-sub">Videos: {P.robotics.agvVideos.map((v, i) => <>{i > 0 && ', '}<a href={`https://youtu.be/${v.id}`}>youtu.be/{v.id}</a></>)}</span></p>
      </section>

      <section>
        <h2>Selected Projects</h2>
        <dl class="cv-dl">
          {P.projects.map((x) => <><dt>{x.title}</dt><dd>{x.description} <span class="cv-sub">({x.context}{x.links?.map((l) => <>{' · '}<a href={l.url}>{l.label}</a></>)})</span></dd></>)}
        </dl>
      </section>
    </article>
  </div>
</div>

<style is:global>
  .viewer {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--bg);
    height: var(--app-h);
  }
  .viewer[hidden] {
    display: none;
  }
  .v-zoom {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }
  .v-scroll {
    overflow: auto;
    padding: 32px 16px calc(48px + env(safe-area-inset-bottom));
    overscroll-behavior: contain;
  }
  .paper {
    --zoom: 1;
    zoom: var(--zoom);
    max-width: 820px;
    margin: 0 auto;
    background: var(--paper);
    color: var(--paper-text);
    font: 400 0.96875rem/1.55 var(--sans);
    padding: clamp(24px, 6vw, 64px) clamp(20px, 7vw, 72px);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25), 0 12px 40px rgb(0 0 0 / 0.25);
  }
  .paper a {
    color: #24597d;
  }
  .paper h1 {
    font-size: 2rem;
    line-height: 1.1;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .cv-alias {
    font-weight: 400;
    color: var(--paper-text-2);
    font-size: 0.6em;
    letter-spacing: 0;
  }
  .cv-role {
    margin: 0 0 10px;
    font-size: 1.0625rem;
    color: #2b6e3c;
    font-weight: 600;
  }
  .cv-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    margin: 0;
    color: var(--paper-text-2);
    font-size: 0.875rem;
  }
  .paper section {
    margin-top: 26px;
  }
  .paper h2 {
    font: 600 0.75rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-text-2);
    border-bottom: 1px solid var(--paper-rule);
    padding-bottom: 8px;
    margin: 0 0 12px;
  }
  .paper h3 {
    font-size: 1rem;
    margin: 0;
    font-weight: 600;
  }
  .paper p {
    margin: 0 0 8px;
  }
  .paper ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }
  .cv-item + .cv-item {
    margin-top: 16px;
  }
  .cv-edu + .cv-edu {
    margin-top: 10px;
  }
  .cv-item-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
  }
  .cv-item-head span {
    color: var(--paper-text-2);
    font-size: 0.875rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cv-sub {
    color: var(--paper-text-2);
    font-size: 0.875rem;
  }
  p.cv-sub {
    margin: 0 0 4px;
  }
  .cv-dl {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 6px 20px;
    margin: 0;
  }
  .cv-dl dt {
    font-weight: 600;
  }
  .cv-dl dd {
    margin: 0;
  }
  @media (max-width: 640px) {
    .cv-dl {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .cv-dl dd {
      margin-bottom: 8px;
    }
    .cv-item-head {
      flex-direction: column;
      gap: 0;
    }
    .v-scroll {
      padding: 0 0 env(safe-area-inset-bottom);
    }
    .paper {
      box-shadow: none;
    }
  }
</style>
