---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="404 — Not found" description="Page not found.">
  <main style="padding: 15vh var(--gutter); max-width: 720px; margin: 0 auto;">
    <p class="comment">$ cat {'<'}this page{'>'}</p>
    <h1 style="font-size:1.5rem;margin:0 0 12px">No such file or directory</h1>
    <p class="o-muted">The page you were looking for does not exist.</p>
    <p><a href={base}>← Back to the terminal</a></p>
  </main>
</Base>
