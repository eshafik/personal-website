---
import Base from '../layouts/Base.astro';
import CV from '../components/CV.astro';
import { profile as P } from '../data/profile';
import { journeyHTML } from '../terminal/journey';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const primary = [
  ['about', 'Personal introduction'],
  ['journey', 'Engineering journey, textiles → AI'],
  ['experience', 'Professional experience'],
  ['expertise', 'Engineering capabilities'],
  ['education', 'Academic qualifications'],
  ['robotics', 'Robotics journey and projects'],
  ['achievements', 'Awards and achievements'],
  ['ventures', 'Technurah & Kids Lab Center'],
  ['projects', 'Engineering projects'],
  ['cv', 'Open full-screen CV'],
  ['contact', 'Contact information'],
  ['links', 'Professional profiles'],
  ['help', 'All commands and keys'],
];

const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const person = `${home}#person`;
const portrait = new URL(`${base}media/portrait-og.jpg`, Astro.site).href;
const pageTitle = `${P.name} (${P.alias}) — Lead Software Engineer & Agentic AI Developer`;
const pageDescription = `${P.role} at ${P.company.name}, ${P.location}. Builds AI agents, RAG systems, Voice AI and real-time customer communication platforms — from textile engineering to Agentic AI.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: `${P.name} (${P.alias})`, inLanguage: 'en', publisher: { '@id': person } },
    {
      '@type': 'ProfilePage',
      '@id': `${home}#profile`,
      url: home,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${home}#website` },
      mainEntity: { '@id': person },
      primaryImageOfPage: { '@id': `${home}#portrait` },
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': person,
      name: P.name,
      alternateName: [P.alias, P.shortName],
      givenName: 'Shafikul',
      familyName: 'Islam',
      jobTitle: P.role,
      description: `${P.summary} ${P.stack}`,
      url: home,
      image: { '@type': 'ImageObject', '@id': `${home}#portrait`, url: portrait, width: 640, height: 640, caption: `Portrait of ${P.name}` },
      worksFor: { '@type': 'Organization', name: P.company.name },
      address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
      alumniOf: P.education.filter((e) => e.institution).map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
      hasCredential: P.education
        .filter((e) => e.institution)
        .map((e) => ({ '@type': 'EducationalOccupationalCredential', name: e.degree, credentialCategory: 'degree', recognizedBy: { '@type': 'CollegeOrUniversity', name: e.institution } })),
      award: P.robotics.awards.map((a) => `${a.place}, ${a.event} ${a.year} (${a.host})`),
      knowsAbout: [...new Set(P.expertise.flatMap((x) => [x.title, ...x.areas]))],
      sameAs: P.links.filter((l) => ['LinkedIn', 'Blog'].includes(l.label)).map((l) => l.url),
      ...(P.contact.email ? { email: `mailto:${P.contact.email}` } : {}),
    },
    ...P.ventures
      .filter((v) => v.role === 'Founder')
      .map((v) => ({ '@type': 'Organization', name: v.name, url: v.url, description: v.description, founder: { '@id': person } })),
  ],
};
const [first, ...rest] = P.name.split(' ');
const msc = P.education.find((e) => e.id === 'masters')!;
---
<Base
  title={`${P.alias} — Lead Software Engineer & Agentic AI Developer`}
  shareTitle={pageTitle}
  description={pageDescription}
  type="profile"
  jsonLd={jsonLd}
  htmlClass="term"
>
  <div class="app" id="app">
    <header class="bar">
      <span class="bar-title"><b>{P.handle}@dhaka</b>: ~</span>
      <button type="button" class="tool hide-touch" data-palette aria-haspopup="dialog">Commands <kbd>Ctrl K</kbd></button>
      <button type="button" class="tool primary" data-open-cv>CV</button>
      <button type="button" class="tool" data-theme-toggle aria-label="Toggle light or dark theme">◐</button>
    </header>

    <main class="screen" id="screen" aria-label="Terminal">
      <div id="output" class="output" aria-live="polite" aria-relevant="additions">
        <section id="welcome" class="welcome" aria-labelledby="name">
          <div class="w-id">
            <p class="comment" aria-hidden="true"># whoami</p>
            <div class="w-hero">
              <img
                class="w-photo"
                src={`${base}media/portrait-400.webp`}
                width="400"
                height="400"
                alt={`Portrait of ${P.name}`}
                fetchpriority="high"
                decoding="async"
              />
              <h1 id="name" class="w-name"><span class="md">{first}</span> {rest.join(' ')} <span class="w-alias">({P.alias})</span></h1>
            </div>
            <p class="w-title">Lead Software Engineer <span class="slash">/</span> Agentic AI Developer</p>
            <p class="w-tag">Currently building intelligent agents and AI-powered communication systems at <strong>{P.company.name}</strong>.</p>
            <dl class="w-kv">
              <dt>location</dt><dd>{P.location}</dd>
              <dt>education</dt><dd><button type="button" class="cmd" data-cmd="education masters">{msc.short}</button>, {msc.institution} · CGPA {msc.score}</dd>
              <dt>ventures</dt><dd>{P.ventures.map((v) => <span class="w-line"><a href={v.url} target="_blank" rel="noopener noreferrer">{v.name} ↗</a> <span class="w-muted">— {v.role ? `${v.role} · ` : ''}{v.tagline}</span></span>)}</dd>
              <dt>focus</dt><dd>{P.focus.join(' · ')}</dd>
              <dt>scope</dt><dd>Backend &amp; DevOps first — full stack with AI-assisted engineering</dd>
              <dt>path</dt><dd>Textile Engineering → Robotics → Software → Agentic AI</dd>
            </dl>
            <div class="w-start">
              <p>Type a command or select one from the suggestions below.</p>
              <ul class="chips" aria-label="Quick commands">
                {['about', 'experience', 'expertise', 'education', 'ventures', 'contact', 'help'].map((c) => (
                  <li><button type="button" class="cmd" data-cmd={c}>{c}</button></li>
                ))}
              </ul>
            </div>
          </div>
          <div class="w-journey">
            <p class="comment" aria-hidden="true"># git log --graph --reverse ~/journey</p>
            <h2 class="sr-only">Engineering journey</h2>
            <Fragment set:html={journeyHTML()} />
          </div>
        </section>
      </div>

      <form class="prompt" id="prompt" role="search" autocomplete="off">
        <div class="prompt-line">
          <label for="cmd" class="ps1"><span class="ps1-user">visitor@shafik</span>:<span class="ps1-path">~</span>$<span class="sr-only"> Command</span></label>
          <input
            id="cmd"
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="suggest"
            aria-describedby="prompt-hint"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            placeholder="type a command, or pick one…"
          />
        </div>
        <ul id="suggest" class="suggest" role="listbox" aria-label="Command suggestions" hidden></ul>
        <p id="prompt-hint" class="sr-only">Suggestions appear as you type. Use up and down arrows to choose, Tab to complete, Enter to run.</p>
      </form>
    </main>

    <footer class="status">
      <span class="mode">VISITOR</span>
      <span class="hints" aria-hidden="true">
        <span><kbd>Tab</kbd> complete</span><span><kbd>↑↓</kbd> history</span><span><kbd>Esc</kbd> dismiss</span><span><kbd>Ctrl L</kbd> clear</span>
      </span>
      <span class="where">{P.company.name} · {P.location}</span>
      <span class="touch">
        <button type="button" class="tool primary" data-palette aria-haspopup="dialog">☰ Commands</button>
        <button type="button" class="tool" data-cmd="home">~ Home</button>
        <button type="button" class="tool" data-open-cv>CV</button>
      </span>
    </footer>
  </div>

  <CV />

  <dialog id="palette" class="palette" aria-labelledby="palette-title">
    <header><span id="palette-title">Commands — tap to run</span><button type="button" class="tool" data-close>Close</button></header>
    <ul>
      {primary.map(([c, d]) => <li><button type="button" data-cmd={c}><b>{c}</b><span>{d}</span></button></li>)}
    </ul>
  </dialog>

  <dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
    <figure><img alt="" /><figcaption></figcaption></figure>
    <button type="button" class="tool" data-close>Close</button>
  </dialog>

  <script>
    import '../terminal/app';
  </script>
</Base>
