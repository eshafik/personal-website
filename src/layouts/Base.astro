---
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  htmlClass?: string;
}
const { title, description, type = 'website', jsonLd, htmlClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#111413" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={new URL(`${base}media/portrait-og.jpg`, Astro.site)} />
    <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Research`} href={`${base}rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var t = localStorage.getItem('shafik.theme');
        if (t !== 'light') t = 'dark'; // dark-first design; light is opt-in via `theme light` / ◐
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
